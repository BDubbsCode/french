   "text": "Il, duav, good."
  },
  {
   "start": 30.98,
   "end": 36.98,
   "text": "So il, perf is about P, E, U, V, E, N, T, il, bull."
  },
  {
   "start": 36.98,
   "end": 41.98,
   "text": "It's about V, E, U, L, E, N, T, il, duav."
