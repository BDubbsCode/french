  },
  {
   "start": 586.95,
   "end": 589.95,
   "text": "Do you remember how to say on time?"
  },
  {
   "start": 589.95,
   "end": 591.95,
   "text": "Do you remember how that was?"
  },
  {
   "start": 591.95,
   "end": 594.95,
   "text": "It was like A-T-E-N-P-S."
  },
  {
   "start": 595.95,
   "end": 596.95,
   "text": "Te tente."
