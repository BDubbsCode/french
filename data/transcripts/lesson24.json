   "end": 11.46,
   "text": "And I eat, I'm eating."
  },
  {
   "start": 11.46,
   "end": 13.46,
   "text": "Je mange."
  },
  {
   "start": 13.46,
   "end": 17.9,
   "text": "Je mange. He eats, he's eating."
